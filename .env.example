# ===========================================
# Vibe-Agents Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env files to version control!
# ===========================================

# -------------------------------------------
# Backend Configuration
# -------------------------------------------

# Application Environment (development, staging, production)
ENVIRONMENT=production

# API Configuration
# Base URL for the backend API
API_URL=http://localhost:8000

# CORS Settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Logging Level (debug, info, warning, error, critical)
LOG_LEVEL=info

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------

# Public API URL for browser-side requests
NEXT_PUBLIC_API_URL=http://localhost:8000

# Node Environment
NODE_ENV=production

# -------------------------------------------
# Optional: Database (for future use)
# -------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/vibe_agents_db

# -------------------------------------------
# Optional: Redis (for future use)
# -------------------------------------------
# REDIS_URL=redis://localhost:6379

# -------------------------------------------
# Optional: External APIs
# -------------------------------------------
# Add any external API keys or configurations here
# EXAMPLE_API_KEY=your-api-key-here
