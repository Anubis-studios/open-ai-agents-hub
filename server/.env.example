# Environment Variables for Vibe-Agents Server

# MuAPI Configuration
MUAPI_BASE_URL=https://api.muapi.ai
MU_API_KEY=your_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/vibe_agents

# Request Timeouts (in seconds)
DEFAULT_TIMEOUT=30
CHAT_TIMEOUT=60
IMAGE_GEN_TIMEOUT=120

# Logging Level
LOG_LEVEL=INFO
